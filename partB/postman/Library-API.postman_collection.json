  "item": [
    {
      "name": "01 - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has accessToken\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"accessToken\");\r",
              "    pm.expect(json.accessToken).to.be.a(\"string\").and.not.be.empty;\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "pm.environment.set(\"token\", json.accessToken);\r",
              "pm.environment.set(\"userId\", json.userId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"admin@library.com\",\r\n    \"password\": \"admin123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Get Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has data array and pagination\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"data\");\r",
              "    pm.expect(json.data).to.be.an(\"array\");\r",
              "    pm.expect(json).to.have.property(\"pagination\");\r",
              "});\r",
              "\r",
              "pm.test(\"Pagination has correct structure\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.pagination).to.include.keys([\"page\", \"limit\", \"total\"]);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
