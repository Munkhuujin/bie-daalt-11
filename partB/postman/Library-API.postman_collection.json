    {
      "name": "03 - Create Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has book id and matches input\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"id\");\r",
              "    pm.expect(json.title).to.equal(\"The Mythical Man-Month\");\r",
              "    pm.expect(json.author).to.equal(\"Fred Brooks\");\r",
              "});\r",
              "\r",
              "pm.test(\"Book has available=true by default\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.available).to.equal(true);\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "pm.environment.set(\"lastBookId\", json.id);"
